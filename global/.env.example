# 复制为 .env 并改掉所有 change-me 后再启动；.env 不入库。
HTTP_PORT=52080
MQTT_PORT=52183
DB_PORT=52420

# 厂↔WAN 链路 TLS（可选；不配只开明文）。证书用 scripts/gen-wan-tls.sh 生成。
# WMESH_TLS_DIR 必须写宿主机绝对路径，updater 换版本时相对路径会落空；不填挂空卷。
# 服务端私钥要让容器用户 10001 读得到：chown 10001:10001 server.key && chmod 0400 server.key
# WMESH_TLS_DIR=/opt/wmesh/global/tls/wan
# WMESH_TLS_CERT_FILE=/etc/wmesh/tls/server.pem
# WMESH_TLS_KEY_FILE=/etc/wmesh/tls/server.key
# HTTPS_PORT=52443
# MQTTS_PORT=52883
# 所有厂都切到 TLS 后，明文端口只留给本机：
# PLAIN_BIND=127.0.0.1

# 数据库
POSTGRES_PASSWORD=change-me-db

# 唯一 WAN 管理员：只在库里还没有管理员时写入一次。
# 忘了密码：把 WMESH_ADMIN_PASSWORD 改成新密码，设 WMESH_ADMIN_RESET=true 后重启；用完务必关掉，否则每次启动都会盖回。
WMESH_ADMIN_LOGIN=wan
WMESH_ADMIN_PASSWORD=change-me-wan
# WMESH_ADMIN_RESET=true

# 对象存储（RustFS，S3 兼容）：WAN 自己的，放平台级资产；管理台用同一对密钥登录
OSS_PORT=52900
OSS_CONSOLE_PORT=52901
OSS_BUCKET=wmesh-global
OSS_ACCESS_KEY=wmesh
OSS_SECRET_KEY=change-me-oss

# 镜像命名（可选）：推私有仓库时填前缀并以 / 结尾，如 registry.example.com/wmesh/
WMESH_REGISTRY=
WMESH_VERSION=dev

# 日志：app 打 JSON；Alloy 采本项目容器后推 Loki。Grafana 查 {job="wmesh",side="global"}
WMESH_LOG_LEVEL=info
LOKI_URL=http://154.82.81.16:3100/loki/api/v1/push
