# 复制为 .env 并改掉所有 change-me 后再启动；.env 不入库。
HTTP_PORT=8080

# 数据库
POSTGRES_PASSWORD=change-me-db

# 建厂引导：WAN 调厂端 /internal/bootstrap 用的共享口令与地址，必须与厂端 .env 一致
WMESH_BOOTSTRAP_TOKEN=change-me-shared-with-factory
WMESH_FACTORY_BOOTSTRAP_URL=http://host.docker.internal:8081

# 唯一 WAN 管理员：只在库里还没有管理员时写入一次
WMESH_ADMIN_LOGIN=wan
WMESH_ADMIN_PASSWORD=change-me-wan

# 对象存储（RustFS，S3 兼容）：WAN 自己的，放平台级资产；管理台用同一对密钥登录
OSS_PORT=9000
OSS_CONSOLE_PORT=9001
OSS_BUCKET=wmesh-global
OSS_ACCESS_KEY=wmesh
OSS_SECRET_KEY=change-me-oss

# 镜像命名（可选）：推私有仓库时填前缀并以 / 结尾，如 registry.example.com/wmesh/
WMESH_REGISTRY=
WMESH_VERSION=dev
