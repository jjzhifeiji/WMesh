// 采本 compose 项目里打了 observe=true 的容器，并收 Pad 的 Loki push，一并推到 LOKI_URL。
// Loki 索引只留 product、service、level。factory 等业务字段留在正文里。

discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
	}

	// 用标签名过滤。observe=true 在部分 Alloy 版本的 Docker 客户端里会匹配成 0 个容器。
	filter {
		name   = "label"
		values = ["observe"]
	}
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_observe"]
		regex         = "true"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_obs_product", "__meta_docker_container_label_obs_service"]
		separator     = ";"
		regex         = "([a-z0-9-]+);([a-z0-9-]+)"
		action        = "keep"
	}

	// Loki service = {product}-{component}，容器标签 obs.service 必须已带 product 前缀

	rule {
		source_labels = ["__meta_docker_container_label_obs_product"]
		target_label  = "product"
	}

	rule {
		source_labels = ["__meta_docker_container_label_obs_service"]
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.process.apps.receiver]
}

loki.process "apps" {
	forward_to = [loki.write.loki.receiver]

	stage.label_drop {
		values = ["container", "job", "side", "service_name", "serviceName", "factory", "client"]
	}

	stage.json {
		expressions = {
			level = "level",
			ts    = `ts || "@timestamp"`,
			msg   = "msg",
		}
		drop_malformed = false
	}

	// 只把 INFO / WARN / ERROR 提升成标签。
	stage.template {
		source   = "keep_level"
		template = `{{ if or (eq .level "INFO") (eq .level "WARN") (eq .level "ERROR") }}{{ .level }}{{ end }}`
	}

	stage.labels {
		values = {
			level = "keep_level",
		}
	}

	stage.timestamp {
		source = "ts"
		format = "RFC3339Nano"
	}

	stage.structured_metadata {
		values = {
			msg = "",
		}
	}

	stage.label_keep {
		values = ["product", "service", "level"]
	}
}

loki.write "loki" {
	endpoint {
		url = sys.env("LOKI_URL")
	}
}

// Pad 直推。时间用平板钟，厂网可达才到得了。
loki.source.api "pad" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 3500
	}
	use_incoming_timestamp = true
	labels                 = {
		product = "wmesh",
		service = "wmesh-pad",
	}
	forward_to = [loki.process.apps.receiver]
}
