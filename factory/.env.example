# 复制为 .env 并改掉所有 change-me 后再启动；.env 不入库。
HTTP_PORT=52081
CLIENT_MQTT_PORT=52184
DISCOVER_UDP_PORT=52082
DB_PORT=52433

# 数据库（维护库账号需能建库，各厂库由服务自动创建）
POSTGRES_PASSWORD=change-me-db

# 厂端连 WAN（出站认领）。本机联调默认打到宿主机 52080。
WMESH_WAN_URL=http://host.docker.internal:52080
WMESH_WAN_MQTT_URL=tcp://host.docker.internal:52183

# 可选：仍给 /internal/bootstrap 用的共享密码；日常建厂不再需要
# WMESH_BOOTSTRAP_TOKEN=

# 对象存储（RustFS，S3 兼容）：点云/图片本体落这里，不进 WAN；管理台用同一对密钥登录
OSS_PORT=52902
OSS_CONSOLE_PORT=52903
OSS_BUCKET=wmesh-factory
OSS_ACCESS_KEY=wmesh
OSS_SECRET_KEY=change-me-oss

# 镜像命名（可选）：推私有仓库时填前缀并以 / 结尾，如 registry.example.com/wmesh/
WMESH_REGISTRY=
WMESH_VERSION=dev
