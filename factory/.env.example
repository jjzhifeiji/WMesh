# 复制为 .env 并改掉所有 change-me 后再启动；.env 不入库。
HTTP_PORT=8081

# 数据库（维护库账号需能建库，各厂库由服务自动创建）
POSTGRES_PASSWORD=change-me-db

# 建厂引导：WAN 调本厂 /internal/bootstrap 用的共享口令，必须与 WAN 端 .env 一致
WMESH_BOOTSTRAP_TOKEN=change-me-shared-with-wan

# 对象存储（RustFS，S3 兼容）：点云/图片本体落这里，不进 WAN；管理台用同一对密钥登录
OSS_PORT=9002
OSS_CONSOLE_PORT=9003
OSS_BUCKET=wmesh-factory
OSS_ACCESS_KEY=wmesh
OSS_SECRET_KEY=change-me-oss

# 镜像命名（可选）：推私有仓库时填前缀并以 / 结尾，如 registry.example.com/wmesh/
WMESH_REGISTRY=
WMESH_VERSION=dev
